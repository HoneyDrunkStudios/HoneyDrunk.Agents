{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkloadsResponse",
  "type": "object",
  "description": "GET /v1/workloads",
  "required": [
    "schemaVersion",
    "generatedAt",
    "workloads"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the response was built (UTC), so a consumer can judge staleness."
    },
    "workloads": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/workloadSummary"
      },
      "description": "The first 20 agents by id; unique ids."
    }
  },
  "$defs": {
    "workloadSummary": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "environment",
        "runs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Not blank; no control characters."
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "runs": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/runSummary"
          },
          "description": "Finished runs only, newest first, unique ids."
        }
      }
    },
    "runSummary": {
      "type": "object",
      "description": "One finished run.",
      "required": [
        "id",
        "status",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "status": {
          "enum": [
            "completed",
            "rejected",
            "halted",
            "failed",
            "awaitingapproval",
            "canceled",
            "propagated"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, ISO-8601."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, ISO-8601. Never before startedAt."
        }
      }
    }
  }
}
