{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditResponse",
  "type": "object",
  "description": "GET /v1/workloads/{id}/audit",
  "required": [
    "schemaVersion",
    "generatedAt",
    "state",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the response was built (UTC), so a consumer can judge staleness."
    },
    "state": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/auditEntryView"
      },
      "description": "The last 7 days, newest first. Empty and meaningless when state is unavailable."
    }
  },
  "$defs": {
    "auditEntryView": {
      "type": "object",
      "description": "One audit entry about the agent. Field changes and metadata are never included.",
      "required": [
        "at",
        "event",
        "actor",
        "outcome",
        "targetType",
        "targetId",
        "reason"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, ISO-8601."
        },
        "event": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "denied",
            "failed",
            "pending"
          ]
        },
        "targetType": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
